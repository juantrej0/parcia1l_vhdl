library IEEE;
use IEEE.std_logic_1164.ALL;

entity SystemOmega is
    port (
        CLK   : in  std_logic;
        RST   : in  std_logic;

        -- Botones (compartidos por Alfa, Beta, Gamma)
        BTN_R, BTN_A, BTN_V : in std_logic;

        -- Switches de control
        FREQ_SEL : in std_logic_vector(2 downto 1);   -- RF1
        FREQ_ON  : in std_logic;                      -- RF1
        PRES_IN  : in std_logic;                      -- RF2/RF3/RF5
        SIZE_IN  : in std_logic;                      -- RF2/RF3/RF5
        MODE     : in std_logic;                      -- RF1 vs RF5 (Alfa)
        NAV_SEL  : in std_logic_vector(1 downto 0);   -- RF4
        NAV_EN   : in std_logic;                      -- RF4 + selección displays

        -- Displays (controlados por Alfa o Delta según NAV_EN)
        DIS1, DIS2, DIS3, DIS4 : out std_logic_vector(6 downto 0);

        -- Salidas de frecuencia (RF1)
        FRECUENCIA : out std_logic;
        Led_CLK    : out std_logic;

        -- Salidas de clasificación (RF3)
        RUTA_RP, RUTA_RG : out std_logic;
        RUTA_VP, RUTA_VG : out std_logic;
        RUTA_AP, RUTA_AG : out std_logic;
        RECHAZO          : out std_logic
    );
end SystemOmega;

architecture arch_SystemOmega of SystemOmega is

    -- ===== Salidas de SystemAlfa =====
    signal alfa_DIS1, alfa_DIS2, alfa_DIS3, alfa_DIS4 : std_logic_vector(6 downto 0);
    signal alfa_FRECUENCIA : std_logic;
    signal alfa_Led_CLK    : std_logic;

    -- ===== Salidas de SystemBeta =====
    signal beta_COLOR_CODE : std_logic_vector(1 downto 0);
    signal beta_SIZE_OUT   : std_logic;
    signal beta_PRES_OUT   : std_logic;
    signal beta_Led_CLK    : std_logic;

    -- ===== Salidas de SystemGamma =====
    signal gamma_RUTA_RP, gamma_RUTA_RG : std_logic;
    signal gamma_RUTA_VP, gamma_RUTA_VG : std_logic;
    signal gamma_RUTA_AP, gamma_RUTA_AG : std_logic;
    signal gamma_RECHAZO : std_logic;
    signal gamma_Led_CLK : std_logic;

    -- ===== Salidas de SystemDelta =====
    signal delta_DIS1, delta_DIS2, delta_DIS3, delta_DIS4 : std_logic_vector(6 downto 0);
    signal delta_TOTAL_OUT : std_logic_vector(3 downto 0);
    signal delta_BIG_OUT   : std_logic_vector(3 downto 0);
    signal delta_SMALL_OUT : std_logic_vector(3 downto 0);
    signal delta_Led_CLK   : std_logic;

    -- ===== Componentes =====
    component SystemAlfa
        port (
            CLK   : in  std_logic;
            BTN_R, BTN_A, BTN_V : in std_logic;
            RST   : in  std_logic;
            FREQ_SEL : in std_logic_vector(2 downto 1);
            FREQ_ON  : in std_logic;
            PRES_IN : in std_logic;
            SIZE_IN : in std_logic;
            MODE    : in std_logic;
            DIS1, DIS2, DIS3, DIS4 : out std_logic_vector(6 downto 0);
            FRECUENCIA : out std_logic;
            Led_CLK    : out std_logic
        );
    end component;

    component SystemBeta
        port (
            CLK   : in  std_logic;
            RST   : in  std_logic;
            PRESENCIA : in std_logic;
            TAMANO    : in std_logic;
            BTN_R     : in std_logic;
            BTN_V     : in std_logic;
            BTN_A     : in std_logic;
            COLOR_CODE : out std_logic_vector(1 downto 0);
            SIZE_OUT   : out std_logic;
            PRES_OUT   : out std_logic;
            Led_CLK    : out std_logic
        );
    end component;

    component SystemGamma
        port (
            CLK   : in  std_logic;
            RST   : in  std_logic;
            PRESENCIA : in std_logic;
            TAMANO    : in std_logic;
            BTN_R     : in std_logic;
            BTN_V     : in std_logic;
            BTN_A     : in std_logic;
            RUTA_RP, RUTA_RG : out std_logic;
            RUTA_VP, RUTA_VG : out std_logic;
            RUTA_AP, RUTA_AG : out std_logic;
            RECHAZO : out std_logic;
            Led_CLK : out std_logic
        );
    end component;

    component SystemDelta
        port (
            CLK   : in  std_logic;
            RST   : in  std_logic;
            COLOR_IN : in std_logic_vector(1 downto 0);
            SIZE_IN  : in std_logic;
            PRES_IN  : in std_logic;
            NAV_SEL : in std_logic_vector(1 downto 0);
            NAV_EN  : in std_logic;
            NEW_BATCH : in std_logic;
            DIS1, DIS2, DIS3, DIS4 : out std_logic_vector(6 downto 0);
            Led_CLK : out std_logic;
            TOTAL_OUT : out std_logic_vector(3 downto 0);
            BIG_OUT   : out std_logic_vector(3 downto 0);
            SMALL_OUT : out std_logic_vector(3 downto 0)
        );
    end component;

begin

    -- ================================================================
    --  Instancia 1: SystemAlfa (RF1 + RF5)
    -- ================================================================
    U_ALFA: SystemAlfa
        port map (
            CLK      => CLK,
            BTN_R    => BTN_R,
            BTN_A    => BTN_A,
            BTN_V    => BTN_V,
            RST      => RST,
            FREQ_SEL => FREQ_SEL,
            FREQ_ON  => FREQ_ON,
            PRES_IN  => PRES_IN,
            SIZE_IN  => SIZE_IN,
            MODE     => MODE,
            DIS1     => alfa_DIS1,
            DIS2     => alfa_DIS2,
            DIS3     => alfa_DIS3,
            DIS4     => alfa_DIS4,
            FRECUENCIA => alfa_FRECUENCIA,
            Led_CLK  => alfa_Led_CLK
        );

    -- ================================================================
    --  Instancia 2: SystemBeta (RF2)
    --  COLOR_CODE alimenta a SystemDelta
    -- ================================================================
    U_BETA: SystemBeta
        port map (
            CLK       => CLK,
            RST       => RST,
            PRESENCIA => PRES_IN,
            TAMANO    => SIZE_IN,
            BTN_R     => BTN_R,
            BTN_V     => BTN_V,
            BTN_A     => BTN_A,
            COLOR_CODE => beta_COLOR_CODE,
            SIZE_OUT   => beta_SIZE_OUT,
            PRES_OUT   => beta_PRES_OUT,
            Led_CLK    => beta_Led_CLK
        );

    -- ================================================================
    --  Instancia 3: SystemGamma (RF3)
    -- ================================================================
    U_GAMMA: SystemGamma
        port map (
            CLK       => CLK,
            RST       => RST,
            PRESENCIA => PRES_IN,
            TAMANO    => SIZE_IN,
            BTN_R     => BTN_R,
            BTN_V     => BTN_V,
            BTN_A     => BTN_A,
            RUTA_RP   => gamma_RUTA_RP,
            RUTA_RG   => gamma_RUTA_RG,
            RUTA_VP   => gamma_RUTA_VP,
            RUTA_VG   => gamma_RUTA_VG,
            RUTA_AP   => gamma_RUTA_AP,
            RUTA_AG   => gamma_RUTA_AG,
            RECHAZO   => gamma_RECHAZO,
            Led_CLK   => gamma_Led_CLK
        );

    -- ================================================================
    --  Instancia 4: SystemDelta (RF4)
    --  COLOR_IN viene de Beta (ya decodificado)
    -- ================================================================
    U_DELTA: SystemDelta
        port map (
            CLK       => CLK,
            RST       => RST,
            COLOR_IN  => beta_COLOR_CODE,
            SIZE_IN   => SIZE_IN,
            PRES_IN   => PRES_IN,
            NAV_SEL   => NAV_SEL,
            NAV_EN    => NAV_EN,
            NEW_BATCH => '1',
            DIS1      => delta_DIS1,
            DIS2      => delta_DIS2,
            DIS3      => delta_DIS3,
            DIS4      => delta_DIS4,
            Led_CLK   => delta_Led_CLK,
            TOTAL_OUT => delta_TOTAL_OUT,
            BIG_OUT   => delta_BIG_OUT,
            SMALL_OUT => delta_SMALL_OUT
        );

    -- ================================================================
    --  SELECCIÓN DE DISPLAYS
    --  NAV_EN = 0 → Alfa (RF1 si MODE=0, RF5 si MODE=1)
    --  NAV_EN = 1 → Delta (RF4: contadores o histórico)
    -- ================================================================
    DIS1 <= delta_DIS1 when NAV_EN = '1' else alfa_DIS1;
    DIS2 <= delta_DIS2 when NAV_EN = '1' else alfa_DIS2;
    DIS3 <= delta_DIS3 when NAV_EN = '1' else alfa_DIS3;
    DIS4 <= delta_DIS4 when NAV_EN = '1' else alfa_DIS4;

    -- ================================================================
    --  OTRAS SALIDAS
    -- ================================================================
    FRECUENCIA <= alfa_FRECUENCIA;
    Led_CLK    <= alfa_Led_CLK;

    RUTA_RP <= gamma_RUTA_RP;
    RUTA_RG <= gamma_RUTA_RG;
    RUTA_VP <= gamma_RUTA_VP;
    RUTA_VG <= gamma_RUTA_VG;
    RUTA_AP <= gamma_RUTA_AP;
    RUTA_AG <= gamma_RUTA_AG;
    RECHAZO <= gamma_RECHAZO;

end arch_SystemOmega;